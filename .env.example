# Copiá este archivo a ".env" y completá los valores reales. Nunca subas el
# archivo ".env" a un repositorio público — tiene tus claves privadas.

# Clave de la API de Claude (console.anthropic.com -> API Keys). Es distinta
# de tu cuenta normal de Claude, se paga por uso (por token), y es lo que
# hace que este servidor pase de "modo demo" a responder de verdad.
ANTHROPIC_API_KEY=

# Modelo a usar. claude-sonnet-4-5 es un buen punto de partida costo/calidad
# para este caso de uso.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Token de acceso de una app de Dropbox con permiso de "App folder" (ver
# sync-dropbox.js para la guía de cómo generarlo).
DROPBOX_ACCESS_TOKEN=

# Carpeta dentro del App folder de Dropbox donde viven los archivos de
# conocimiento (reglas.md, redes-sociales.md, etc.) y el manifiesto de la
# lectura diaria (processed-files.json).
DROPBOX_KNOWLEDGE_FOLDER=/mentis-reglas

# Carpeta de alimentación (Módulo 01) — dejar vacío significa "la raíz del
# App folder": una sola carpeta plana donde Rodrigo sube todos los libros
# juntos, sin subcarpetas por categoría (decisión explícita, ver el plano).
DROPBOX_FEEDING_FOLDER=

# Secreto propio de la lectura diaria — sin esto configurado, la ruta
# /internal/daily-ingest queda cerrada por completo, ni siquiera responde.
# Generá cualquier string largo y random (por ejemplo con
# `openssl rand -hex 24` en una terminal) y usalo también en el secret de
# GitHub Actions que dispara esta ruta una vez por día (ver
# .github/workflows/daily-ingest.yml).
INGEST_SECRET=

# Cuántos archivos nuevos procesa como máximo una sola corrida de la lectura
# diaria — para no pasarse de tiempo ni de costo de API en una ejecución. Si
# hay más archivos nuevos que este número, los que sobran quedan para la
# corrida del día siguiente.
INGEST_MAX_FILES_PER_RUN=3

# Carpeta dentro del App folder de Dropbox donde se guardan los guiones
# generados por el guion diario (Módulo 03) y su historial
# (content-history.json).
DROPBOX_CONTENT_FOLDER=/mentis-contenido

# Secreto propio del guion diario — sin esto configurado, la ruta
# /internal/daily-script queda cerrada por completo, igual que INGEST_SECRET.
# Generá otro string largo y random, distinto al de INGEST_SECRET, y usalo
# también en el secret de GitHub Actions que dispara esta ruta
# (ver .github/workflows/daily-script.yml).
SCRIPT_SECRET=

# Puerto donde corre el servidor localmente.
PORT=3000

# --- Acceso (dos sistemas separados, nunca se cruzan) -----------------------
# En "false" (default) el servidor no exige acceso — sirve para probar en
# local sin depender de Systeme.io. Poner en "true" antes de mostrárselo a
# un cliente real.
REQUIRE_ACCESS_CHECK=false

# Secreto compartido con el webhook de Systeme.io de la oferta premium del
# chat (Módulo 04/08). Cuando alguien compra, Systeme.io llama a
# /webhook/systeme-premium con este secreto y el email queda habilitado en
# access-premium.json.
SYSTEME_PREMIUM_WEBHOOK_SECRET=

# Secreto compartido con el webhook de Systeme.io de la formación en vivo
# (Módulo 02 — réplica del panel). Completamente separado del de arriba:
# habilita access-panel-alumnos.json, nunca access-premium.json.
SYSTEME_PANEL_WEBHOOK_SECRET=
